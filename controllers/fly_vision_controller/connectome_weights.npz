    import numpy as np

    has_soma = neurons_df["somaLocation"].notna()
    n_missing = (~has_soma).sum()
    if n_missing > 0:
        print(f"{n_missing} neurone(s) sans somaLocation, exclus du calcul d'angle.")

    neurons_df = neurons_df[has_soma].reset_index(drop=True)
    conn_df = conn_df[conn_df["bodyId_post"].isin(neurons_df["bodyId"])].reset_index(drop=True)

    coords = np.array(neurons_df["somaLocation"].tolist())
    neurons_df["x"] = coords[:, 0]
    neurons_df["y"] = coords[:, 1]


    profile = build_weight_profile(neurons_df, conn_df)
    save_weights(profile, out_path="/content/connectome_weights.npz")



    
    # Display fetched data
    print("Fetched neurons_df head:")
    display(neurons_df.head())
    print("\nFetched conn_df head:")
